# Supabase (MM-002) — copy to .env.local and fill in from Project Settings -> API
# Do not put real credentials in this file; it is committed to the repository.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (ADR-005) — server-side only, consumed via the AI service abstraction.
OPENAI_API_KEY=your-openai-api-key
